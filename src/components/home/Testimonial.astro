---
import { Icon } from "astro-icon/components";
import Container from "@/components/Container";
import { testimonial } from "@/data/site";
import direnziMark from "@/assets/logos/direnzi-mark.svg";
---

<section class="px-2 sm:px-4" aria-label="Client review">
  <div
    class="rounded-[1.5rem] surface-dark py-20 sm:rounded-panel md:py-28 lg:py-32"
  >
    <Container>
      <figure class="mx-auto max-w-5xl" data-reveal>
        <div class="flex gap-1" role="img" aria-label="5 out of 5 stars">
          {
            Array.from({ length: 5 }).map(() => (
              <Icon
                name="lucide:star"
                class="size-5 text-signal [&_g]:fill-signal"
                aria-hidden="true"
              />
            ))
          }
        </div>
        <blockquote
          class="mt-8 text-[clamp(1.5rem,3.2vw,2.5rem)] leading-[1.25] font-[400] tracking-[-0.022em] text-pretty"
        >
          <p>“{testimonial.quote}”</p>
        </blockquote>
        <figcaption class="mt-10 flex items-center gap-4">
          <span
            class="inline-flex size-12 items-center justify-center rounded-full bg-white"
          >
            <img
              src={direnziMark.src}
              width={direnziMark.width}
              height={direnziMark.height}
              alt=""
              class="h-6 w-auto"
            />
          </span>
          <span>
            <span class="block font-medium">{testimonial.author}</span>
            <span class="block text-sm text-white/60">{testimonial.source}</span
            >
          </span>
        </figcaption>
      </figure>
    </Container>
  </div>
</section>
