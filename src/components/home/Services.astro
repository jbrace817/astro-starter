---
import { Icon } from "astro-icon/components";
import Container from "@/components/Container";
import { services } from "@/data/site";
---

<section
  class="border-t border-line py-20 md:py-28 lg:py-32"
  aria-labelledby="services-title"
>
  <Container>
    <h2 id="services-title" class="max-w-4xl text-h2" data-reveal>
      Web Design and Local SEO for Bucks County Businesses
    </h2>

    <ul class="mt-14 grid gap-4 md:mt-20 md:grid-cols-2">
      {
        services.map((service) => (
          <li data-reveal>
            <a
              href={service.href}
              class="group flex h-full flex-col rounded-card border border-transparent bg-white p-7 transition-colors duration-200 hover:border-ink sm:p-10"
            >
              <div class="flex items-start justify-between gap-6">
                <h3 class="max-w-[16ch] text-h3">{service.title}</h3>
                <span class="inline-flex size-11 shrink-0 items-center justify-center rounded-full border border-line transition-colors duration-200 group-hover:border-ink group-hover:bg-ink group-hover:text-white">
                  <Icon
                    name="lucide:arrow-up-right"
                    class="size-5"
                    aria-hidden="true"
                  />
                </span>
              </div>
              <p class="mt-8 max-w-[44ch] text-subtle sm:mt-16">
                {service.body}
              </p>
            </a>
          </li>
        ))
      }
    </ul>
  </Container>
</section>
