---
import { Icon } from "astro-icon/components";
import Container from "@/components/Container";
import { included, links, plans } from "@/data/site";

const cards = [
  { ...plans.launch, key: "launch" as const, featured: false },
  { ...plans.grow, key: "grow" as const, featured: true },
];
---

<section
  id="pricing"
  class="border-t border-line py-20 md:py-28 lg:py-32"
  aria-labelledby="plans-title"
>
  <Container>
    <div class="grid gap-14 lg:grid-cols-12 lg:gap-10">
      <div class="lg:col-span-5" data-reveal>
        <h2 id="plans-title" class="text-h2">
          What Your Monthly Plan Includes
        </h2>
        <p class="mt-6 max-w-[34ch] text-lead text-subtle">
          One monthly price covers the work most businesses hire three companies
          to do.
        </p>
        <ul class="mt-10 divide-y divide-line border-y border-line">
          {
            included.map((item) => (
              <li class="flex gap-3 py-3">
                <Icon
                  name="lucide:check"
                  class="mt-1 size-4 shrink-0 text-amber-deep"
                  aria-hidden="true"
                />
                <span>{item}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="lg:col-span-7 lg:pt-2">
        <div class="grid gap-4 sm:grid-cols-2">
          {
            cards.map((plan) => (
              <article
                class:list={[
                  "flex flex-col rounded-card p-7 sm:p-8",
                  plan.featured ? "surface-dark" : "bg-white",
                ]}
                aria-labelledby={`plan-${plan.key}`}
                data-reveal
              >
                <div class="flex items-center justify-between gap-3">
                  <h3
                    id={`plan-${plan.key}`}
                    class="text-xl font-medium tracking-[-0.015em]"
                  >
                    {plan.name}
                  </h3>
                  {plan.featured && (
                    <span class="rounded-full bg-signal px-3 py-1 text-xs font-medium text-ink">
                      Most popular
                    </span>
                  )}
                </div>
                <p class="mt-6 flex items-baseline gap-1">
                  <span class="text-[3.5rem] leading-none font-[420] tracking-[-0.04em] [font-stretch:108%]">
                    {plan.price}
                  </span>
                  <span
                    class:list={[
                      plan.featured ? "text-white/70" : "text-subtle",
                    ]}
                  >
                    /mo
                  </span>
                </p>
                <p
                  class:list={[
                    "mt-3 sm:min-h-12",
                    plan.featured ? "text-white/70" : "text-subtle",
                  ]}
                >
                  {plan.bestFor}
                </p>

                <dl
                  class:list={[
                    "mt-6 divide-y border-t text-[0.9375rem]",
                    plan.featured
                      ? "divide-white/12 border-white/12"
                      : "divide-line border-line",
                  ]}
                >
                  {plans.rows.map((row) => {
                    const value = row[plan.key];
                    return (
                      <div class="flex items-start justify-between gap-4 py-3">
                        <dt
                          class:list={[
                            plan.featured ? "text-white/70" : "text-subtle",
                          ]}
                        >
                          {row.label}
                        </dt>
                        <dd class="w-28 shrink-0 text-right font-medium">
                          {value ?? (
                            <>
                              <Icon
                                name="lucide:minus"
                                class="inline size-4 text-subtle/60"
                                aria-hidden="true"
                              />
                              <span class="sr-only">Not included</span>
                            </>
                          )}
                        </dd>
                      </div>
                    );
                  })}
                </dl>
              </article>
            ))
          }
        </div>

        <p class="mt-6 text-sm leading-relaxed text-subtle" data-reveal>
          {
            plans.terms.map((term, i) => (
              <>
                {i > 0 && (
                  <span aria-hidden="true" class="mx-2 text-line">
                    •
                  </span>
                )}
                <span>{term}</span>
              </>
            ))
          }
        </p>
        <a
          href={links.pricing}
          class="group mt-6 inline-flex items-center gap-2 font-medium"
        >
          See full pricing
          <Icon
            name="lucide:arrow-right"
            class="size-4 transition-transform duration-200 group-hover:translate-x-1"
            aria-hidden="true"
          />
        </a>
      </div>
    </div>
  </Container>
</section>
