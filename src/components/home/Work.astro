---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import Container from "@/components/Container";
import capitalSite from "@/assets/work/capital-desktop.png";
import piccionesSite from "@/assets/work/picciones-desktop.png";

// Di Renzi monthly Google impressions, from the case study. Bars are drawn to scale.
const before = 619;
const after = 2307;

// Cards 2 and 3 show the live sites only. Their numbers are pending from James,
// and the draft says not to publish placeholder numbers.
const sites = [
  {
    name: "Capital Cleaning",
    trade: "House and office cleaning, Collegeville",
    url: "https://capitalcleaningco.com",
    image: capitalSite,
  },
  {
    name: "Piccione's Heating & Cooling",
    trade: "HVAC, South Philadelphia",
    url: "https://piccionesheatingandcooling.com",
    image: piccionesSite,
  },
];
---

<section
  class="border-t border-line py-20 md:py-28 lg:py-32"
  aria-labelledby="work-title"
>
  <Container>
    <h2 id="work-title" class="text-h2" data-reveal>Work With Results</h2>

    <article
      class="mt-14 grid gap-12 rounded-panel surface-dark p-7 sm:p-10 md:mt-20 lg:grid-cols-12 lg:grid-rows-[auto_1fr] lg:gap-10 lg:p-14"
      data-reveal
    >
      <div class="lg:col-span-5 lg:row-start-1">
        <h3 class="text-h3">Di Renzi Brothers, Plumbing</h3>
        <p class="mt-4 max-w-[42ch] text-white/70">
          They showed up for more than 200 local searches within 4 months of
          launch. One website request was a new construction job worth $30,000
          to $120,000.
        </p>
      </div>

      <figure class="lg:col-span-7 lg:col-start-6 lg:row-span-2 lg:row-start-1">
        <p
          class="text-[clamp(2.75rem,7vw,6rem)] leading-[0.9] font-[380] tracking-[-0.045em] [font-stretch:110%]"
        >
          {before.toLocaleString("en-US")} to {after.toLocaleString("en-US")}
        </p>
        <figcaption class="mt-4 text-lead text-white/70">
          monthly Google impressions.
        </figcaption>

        <div
          class="mt-10 grid grid-cols-[1fr_auto] items-center gap-x-4 gap-y-3"
          aria-hidden="true"
        >
          <div class="h-3">
            <div
              class="h-full rounded-full bg-white/25"
              style={`width: ${(before / after) * 100}%`}
            >
            </div>
          </div>
          <span class="text-sm text-white/60"
            >{before.toLocaleString("en-US")}</span
          >
          <div class="h-3 origin-left rounded-full bg-signal" data-bar></div>
          <span class="text-sm text-white">{after.toLocaleString("en-US")}</span
          >
        </div>
      </figure>

      <a
        href="/work/plumbing-website-case-study"
        class="group inline-flex items-center gap-2 justify-self-start font-medium text-white lg:col-span-5 lg:row-start-2 lg:self-end"
      >
        Read the case study
        <Icon
          name="lucide:arrow-right"
          class="size-4 transition-transform duration-200 group-hover:translate-x-1"
          aria-hidden="true"
        />
      </a>
    </article>

    <ul class="mt-4 grid gap-4 md:grid-cols-2">
      {
        sites.map((site) => (
          <li data-reveal>
            <a
              href={site.url}
              target="_blank"
              rel="noopener"
              class="group block h-full rounded-card border border-transparent bg-white p-3 transition-colors duration-200 hover:border-ink"
            >
              <div class="overflow-hidden rounded-[0.75rem] bg-paper">
                <Image
                  src={site.image}
                  alt={`The ${site.name} website, built by OneUp`}
                  widths={[480, 720, 960, 1280]}
                  sizes="(min-width: 768px) 45vw, 100vw"
                  class="aspect-[16/10] h-auto w-full object-cover object-top transition-transform duration-500 group-hover:scale-[1.015]"
                />
              </div>
              <div class="flex items-center justify-between gap-4 px-4 pt-5 pb-4">
                <div>
                  <h3 class="text-xl font-medium tracking-[-0.015em]">
                    {site.name}
                  </h3>
                  <p class="mt-1 text-sm text-subtle">{site.trade}</p>
                </div>
                <span class="inline-flex shrink-0 items-center gap-1.5 text-sm font-medium">
                  Visit site
                  <Icon
                    name="lucide:arrow-up-right"
                    class="size-4"
                    aria-hidden="true"
                  />
                  <span class="sr-only">(opens in a new tab)</span>
                </span>
              </div>
            </a>
          </li>
        ))
      }
    </ul>
  </Container>
</section>
