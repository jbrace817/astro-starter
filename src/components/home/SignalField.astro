---
// The hero's only visual: a dim field of dots on ink, breathing slowly, with one
// dot lit in signal amber. It reads as "stand out / get found" and has no
// geography, so it never implies a Bucks-only service area.
//
// WebGL fragment shader, a few KB, no dependencies. Falls back to a static CSS
// dot pattern when WebGL is missing or the visitor prefers reduced motion.
import { cn } from "@/lib/utils";

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div
  class={cn("signal-field pointer-events-none select-none", className)}
  data-signal-field
  aria-hidden="true"
>
  <canvas class="signal-field__canvas" data-signal-canvas></canvas>
</div>

<style>
  .signal-field {
    /* Where the lit dot sits, as a fraction of the field. Read by the script. */
    --signal-x: 0.86;
    --signal-y: 0.07;
    --dot-spacing: 26;
    background-color: var(--color-ink);
    /* Static fallback: the same dot grid, no motion, no signal. */
    background-image: radial-gradient(
      circle at center,
      rgba(255, 255, 255, 0.12) 1px,
      transparent 1.6px
    );
    background-size: 26px 26px;
    mask-image: radial-gradient(
      ellipse 80% 80% at 60% 50%,
      #000 40%,
      transparent 100%
    );
  }

  @media (min-width: 1024px) {
    .signal-field {
      --signal-x: 0.78;
      --signal-y: 0.4;
      --dot-spacing: 30;
      background-size: 30px 30px;
    }
  }

  .signal-field__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    opacity: 0;
    transition: opacity 1.2s ease-out;
  }

  .signal-field.is-live {
    /* Once the shader is drawing, hide the CSS fallback so they do not stack. */
    background-image: none;
    mask-image: none;
  }

  .signal-field.is-live .signal-field__canvas {
    opacity: 1;
  }
</style>

<script>
  const VERT = `
    attribute vec2 a;
    void main() { gl_Position = vec4(a, 0.0, 1.0); }
  `;

  const FRAG = `
    precision highp float;
    uniform vec2 u_res;
    uniform float u_time;
    uniform vec2 u_signal;
    uniform float u_spacing;
    uniform float u_dpr;

    float hash(vec2 p) {
      return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453);
    }

    float noise(vec2 p) {
      vec2 i = floor(p);
      vec2 f = fract(p);
      f = f * f * (3.0 - 2.0 * f);
      return mix(
        mix(hash(i), hash(i + vec2(1.0, 0.0)), f.x),
        mix(hash(i + vec2(0.0, 1.0)), hash(i + vec2(1.0, 1.0)), f.x),
        f.y
      );
    }

    void main() {
      vec2 px = gl_FragCoord.xy;
      vec2 uv = px / u_res;

      // Dot grid.
      vec2 cell = floor(px / u_spacing);
      vec2 center = (cell + 0.5) * u_spacing;
      float d = length(px - center);
      float r = 1.15 * u_dpr;
      float dot = 1.0 - smoothstep(r - 0.9 * u_dpr, r + 0.9 * u_dpr, d);

      // Slow breathing across the field.
      float n = noise(cell * 0.14 + vec2(u_time * 0.045, -u_time * 0.03));
      float base = 0.06 + 0.13 * n;

      // Fade the field toward the edges so it never hits the panel border.
      float vig = smoothstep(0.0, 0.18, uv.x)
        * smoothstep(0.0, 0.12, 1.0 - uv.x)
        * smoothstep(0.0, 0.2, uv.y)
        * smoothstep(0.0, 0.2, 1.0 - uv.y);
      base *= vig;

      // The signal: one lit dot, a soft halo, and a slow outward ring.
      vec2 sCell = floor(u_signal / u_spacing);
      vec2 sCenter = (sCell + 0.5) * u_spacing;
      float ds = length(px - sCenter);
      float pulse = 0.5 + 0.5 * sin(u_time * 1.4);

      float halo = exp(-ds / (u_spacing * (1.6 + 0.8 * pulse)));
      float near = exp(-length(center - sCenter) / (u_spacing * 2.8));

      float ringMax = u_spacing * 7.0;
      float ringR = mod(u_time * 22.0 * u_dpr, ringMax);
      float ring = (1.0 - smoothstep(0.0, 1.6 * u_dpr, abs(ds - ringR)))
        * (1.0 - ringR / ringMax);

      vec3 ink = vec3(0.0745, 0.0745, 0.0784);
      vec3 amber = vec3(1.0, 0.773, 0.239);

      vec3 col = ink;
      col += vec3(1.0) * dot * base;
      col += amber * dot * near * (0.55 + 0.45 * pulse);
      col += amber * halo * (0.18 + 0.14 * pulse);
      col += amber * ring * 0.28;

      float sr = u_spacing * 0.2 * (1.0 + 0.18 * pulse);
      float sdot = 1.0 - smoothstep(sr - u_dpr, sr + u_dpr, ds);
      col = mix(col, amber, sdot);

      // A little grain so the black is not flat.
      col += (hash(px + fract(u_time)) - 0.5) * 0.025;

      gl_FragColor = vec4(col, 1.0);
    }
  `;

  function start(field: HTMLElement) {
    const canvas = field.querySelector<HTMLCanvasElement>(
      "[data-signal-canvas]",
    );
    if (!canvas) return;

    const gl = canvas.getContext("webgl", {
      antialias: false,
      alpha: false,
      powerPreference: "low-power",
    });
    if (!gl) return;

    const compile = (type: number, src: string) => {
      const s = gl.createShader(type)!;
      gl.shaderSource(s, src);
      gl.compileShader(s);
      if (!gl.getShaderParameter(s, gl.COMPILE_STATUS)) {
        console.warn(gl.getShaderInfoLog(s));
        return null;
      }
      return s;
    };

    const vs = compile(gl.VERTEX_SHADER, VERT);
    const fs = compile(gl.FRAGMENT_SHADER, FRAG);
    if (!vs || !fs) return;

    const prog = gl.createProgram()!;
    gl.attachShader(prog, vs);
    gl.attachShader(prog, fs);
    gl.linkProgram(prog);
    if (!gl.getProgramParameter(prog, gl.LINK_STATUS)) return;
    gl.useProgram(prog);

    // One full-screen triangle.
    const buf = gl.createBuffer();
    gl.bindBuffer(gl.ARRAY_BUFFER, buf);
    gl.bufferData(
      gl.ARRAY_BUFFER,
      new Float32Array([-1, -1, 3, -1, -1, 3]),
      gl.STATIC_DRAW,
    );
    const a = gl.getAttribLocation(prog, "a");
    gl.enableVertexAttribArray(a);
    gl.vertexAttribPointer(a, 2, gl.FLOAT, false, 0, 0);

    const uRes = gl.getUniformLocation(prog, "u_res");
    const uTime = gl.getUniformLocation(prog, "u_time");
    const uSignal = gl.getUniformLocation(prog, "u_signal");
    const uSpacing = gl.getUniformLocation(prog, "u_spacing");
    const uDpr = gl.getUniformLocation(prog, "u_dpr");

    let dpr = 1;
    let width = 0;
    let height = 0;

    const resize = () => {
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      const rect = field.getBoundingClientRect();
      width = Math.max(1, Math.round(rect.width * dpr));
      height = Math.max(1, Math.round(rect.height * dpr));
      canvas.width = width;
      canvas.height = height;
      gl.viewport(0, 0, width, height);

      const css = getComputedStyle(field);
      const sx = parseFloat(css.getPropertyValue("--signal-x")) || 0.75;
      const sy = parseFloat(css.getPropertyValue("--signal-y")) || 0.45;
      const spacing = (parseFloat(css.getPropertyValue("--dot-spacing")) || 28) * dpr;

      gl.uniform2f(uRes, width, height);
      // GL's y axis points up, CSS's points down.
      gl.uniform2f(uSignal, sx * width, (1 - sy) * height);
      gl.uniform1f(uSpacing, spacing);
      gl.uniform1f(uDpr, dpr);
    };

    let raf = 0;
    let visible = true;
    const t0 = performance.now();

    const frame = (now: number) => {
      raf = 0;
      if (!visible || document.hidden) return;
      gl.uniform1f(uTime, (now - t0) / 1000);
      gl.drawArrays(gl.TRIANGLES, 0, 3);
      raf = requestAnimationFrame(frame);
    };

    const wake = () => {
      if (!raf && visible && !document.hidden) raf = requestAnimationFrame(frame);
    };

    new ResizeObserver(resize).observe(field);
    new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      wake();
    }).observe(field);
    document.addEventListener("visibilitychange", wake);

    resize();
    field.classList.add("is-live");
    wake();
  }

  // Only run the shader when motion is allowed. The static CSS dots stay otherwise.
  if (document.documentElement.classList.contains("motion")) {
    document
      .querySelectorAll<HTMLElement>("[data-signal-field]")
      .forEach(start);
  }
</script>
