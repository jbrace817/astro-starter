---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import Container from "@/components/Container";
import Button from "@/components/Button.astro";
import BrowserFrame from "@/components/BrowserFrame.astro";
import { benefits, contact, links } from "@/data/site";
import direnziSite from "@/assets/work/direnzi-desktop.png";
import direnziMark from "@/assets/logos/direnzi-mark.svg";
import direnziWordmark from "@/assets/logos/direnzi-wordmark.svg";
import capitalLogo from "@/assets/logos/capital-cleaning.svg";
import piccionesEmblem from "@/assets/logos/picciones-emblem.png";
---

<section class="px-2 sm:px-4" aria-labelledby="hero-title">
  <div class="overflow-hidden rounded-[1.5rem] surface-dark sm:rounded-panel">
    <Container className="pt-14 sm:pt-20 lg:pt-24">
      <div class="grid gap-14 lg:grid-cols-12 lg:items-center lg:gap-10">
        <div class="lg:col-span-7">
          <!-- The display line is styled big but is not a heading tag (draft v3). -->
          <p class="text-display">
            <span class="block">Designed to be found.</span>
            <span class="block">Built to be chosen.</span>
            <span class="block">Launched for $0.</span>
          </p>
          <p class="mt-6 text-lead font-medium">
            Plans start at $149/mo. You do not pay until you approve your site.
          </p>

          <h1
            id="hero-title"
            class="mt-10 text-lg font-medium tracking-[-0.01em]"
          >
            Web Design for Bucks County Businesses
          </h1>
          <p class="mt-2 max-w-[54ch] text-white/70">
            Custom web design for Bucks County businesses. Every project starts
            with a free look at your competitors. Then we build a fast site
            designed to turn visitors into calls, and get you showing up on
            Google Maps.
          </p>

          <div
            class="mt-9 flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-center"
          >
            <Button href={links.report}>Get Your Free Competitor Report</Button>
            <Button href={links.bookCall} variant="outline-light"
              >Book a Call</Button
            >
            <a
              href={contact.phoneHref}
              class="inline-flex items-center justify-center gap-2 py-3 text-white/80 hover:text-white sm:ml-3"
            >
              <Icon name="lucide:phone" class="size-4" aria-hidden="true" />
              Call {contact.phone}
            </a>
          </div>
        </div>

        <!-- The frame runs off the panel's right edge on large screens. -->
        <div class="lg:col-span-5 lg:-mr-[22vw] xl:-mr-[18vw]" data-hero-device>
          <BrowserFrame
            src={direnziSite}
            alt="The Di Renzi Brothers plumbing website, built by OneUp"
            url="direnzibrothers.com"
            sizes="(min-width: 1024px) 760px, 100vw"
            loading="eager"
          />
        </div>
      </div>

      <div
        class="mt-14 grid gap-8 border-t border-white/12 py-8 lg:mt-20 lg:grid-cols-12 lg:items-center lg:gap-10"
      >
        <ul
          class="flex flex-wrap gap-2 lg:col-span-7"
          aria-label="What you get"
        >
          {
            benefits.map((item) => (
              <li class="rounded-full border border-white/15 px-3 py-1.5 text-[0.8125rem] leading-none text-white/80">
                {item}
              </li>
            ))
          }
        </ul>

        <div
          class="flex flex-wrap items-center gap-x-8 gap-y-5 lg:col-span-5 lg:justify-end"
        >
          <ul
            class="flex items-center gap-6 opacity-70"
            aria-label="Clients: Di Renzi Brothers, Capital Cleaning, Piccione's Heating & Cooling"
          >
            <li class="flex items-center gap-2">
              <img
                src={direnziMark.src}
                width={direnziMark.width}
                height={direnziMark.height}
                alt=""
                class="h-6 w-auto brightness-0 invert"
              />
              <img
                src={direnziWordmark.src}
                width={direnziWordmark.width}
                height={direnziWordmark.height}
                alt=""
                class="hidden h-3 w-auto sm:block"
              />
            </li>
            <li>
              <img
                src={capitalLogo.src}
                width={capitalLogo.width}
                height={capitalLogo.height}
                alt=""
                class="h-6 w-auto"
              />
            </li>
            <li class="flex items-center gap-2">
              <Image
                src={piccionesEmblem}
                alt=""
                width={60}
                class="h-6 w-auto brightness-0 invert"
              />
              <span class="text-xs font-semibold tracking-[0.04em]"
                >PICCIONE'S</span
              >
            </li>
          </ul>
          <p class="flex items-center gap-1.5 text-sm text-white/80">
            <Icon
              name="lucide:star"
              class="size-4 text-signal [&_g]:fill-signal"
              aria-hidden="true"
            />
            <span class="">5.0 on Google</span>
          </p>
        </div>
      </div>
    </Container>
  </div>
</section>
