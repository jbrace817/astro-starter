---
import { Icon } from "astro-icon/components";
import Container from "@/components/Container";
import Button from "@/components/Button.astro";
import SignalField from "@/components/home/SignalField.astro";
import { contact, links } from "@/data/site";

// Hero v4: the three display lines are the whole visual. No browser frame, no
// client logos, no pill list. One signal dot in the field behind the type.
// Client logos moved to the Work section.
---

<section class="relative overflow-hidden surface-dark" aria-labelledby="hero-title">
  <SignalField class="absolute inset-0" />

  <!-- Keeps the type readable over the dots on wide screens. -->
  <div
    class="pointer-events-none absolute inset-0 hidden lg:block"
    style="background: linear-gradient(90deg, rgba(19,19,20,0.78) 0%, rgba(19,19,20,0.45) 38%, rgba(19,19,20,0) 62%);"
    aria-hidden="true"
  ></div>

  <Container
    className="relative flex flex-col justify-between pt-24 pb-7 sm:pt-24 lg:min-h-[calc(100svh-4.5rem)] lg:pt-20"
  >
    <div>
      <!-- The display line is styled big but is not a heading tag (draft v3). -->
      <p class="hero-display">
        <span class="hero-line" style="--i: 0">
          Designed to be <em class="hero-word" style="--w: 0">found.</em>
        </span>
        <span class="hero-line" style="--i: 1">
          Built to be <em class="hero-word" style="--w: 1">chosen.</em>
        </span>
        <span class="hero-line" style="--i: 2">
          Launched for <em class="hero-word hero-word--final" style="--w: 2"
            >$0.</em
          >
        </span>
      </p>

      <p class="hero-line mt-7 text-lead font-medium" style="--i: 3">
        Plans start at $149/mo. You do not pay until you approve your site.
      </p>

      <div class="hero-line mt-10 lg:mt-12" style="--i: 4">
        <h1
          id="hero-title"
          class="text-lg font-medium tracking-[-0.01em]"
        >
          Web Design for Bucks County Businesses
        </h1>
        <p class="mt-2 max-w-[54ch] text-white/70">
          Custom web design for Bucks County businesses. Every project starts
          with a free look at your competitors. Then we build a fast site
          designed to turn visitors into calls, and get you showing up on
          Google Maps.
        </p>
      </div>

      <div
        class="hero-line mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-center"
        style="--i: 5"
      >
        <Button href={links.report}>Get Your Free Competitor Report</Button>
        <Button href={links.bookCall} variant="outline-light">Book a Call</Button>
        <a
          href={contact.phoneHref}
          class="inline-flex items-center justify-center gap-2 py-3 text-white/80 hover:text-white sm:ml-3"
        >
          <Icon name="lucide:phone" class="size-4" aria-hidden="true" />
          Call {contact.phone}
        </a>
      </div>
    </div>

    <div
      class="hero-line mt-16 flex flex-col gap-4 border-t border-white/12 pt-6 text-sm text-white/70 sm:flex-row sm:items-center sm:justify-between lg:mt-12"
      style="--i: 6"
    >
      <p class="max-w-[52ch]">
        Based in Bucks County. Working with businesses across Montgomery
        County, Philadelphia, and the surrounding area.
      </p>
      <p class="flex shrink-0 items-center gap-1.5 text-white/80">
        <Icon
          name="lucide:star"
          class="size-4 text-signal [&_g]:fill-signal"
          aria-hidden="true"
        />
        5.0 on Google
      </p>
    </div>
  </Container>
</section>

<style>
  /* Bigger than text-display: the type owns the hero now. */
  .hero-display {
    font-size: clamp(2.85rem, 6.2vw, 5.5rem);
    line-height: 0.98;
    letter-spacing: -0.04em;
    font-weight: 430;
    font-stretch: 108%;
  }

  .hero-display .hero-line {
    display: block;
  }

  .hero-word {
    font-style: normal;
    color: #fff;
  }

  /* Without motion (or without JS), "$0" carries the amber. */
  :global(html:not(.motion)) .hero-word--final {
    color: var(--color-signal);
  }

  /* With motion: lines rise in one at a time on load... */
  :global(.motion) .hero-line {
    opacity: 0;
    animation: hero-rise 0.9s cubic-bezier(0.22, 1, 0.36, 1) both;
    animation-delay: calc(var(--i) * 140ms + 120ms);
  }

  /* ...then the amber drifts found -> chosen -> $0 and loops. 3 words, 3s each. */
  :global(.motion) .hero-word {
    animation: hero-signal 9s ease-in-out infinite;
    animation-delay: calc(var(--w) * 3s + 1.1s);
  }

  @keyframes hero-rise {
    from {
      opacity: 0;
      transform: translateY(22px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* Each word: fade to amber, hold for its 3s slot, fade back, wait for the loop. */
  @keyframes hero-signal {
    0% {
      color: #fff;
    }
    6%,
    30% {
      color: var(--color-signal);
    }
    38%,
    100% {
      color: #fff;
    }
  }
</style>
