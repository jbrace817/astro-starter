---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { cn } from "@/lib/utils";

// A plain browser window around a real client screenshot.
interface Props {
  src: ImageMetadata;
  alt: string;
  url: string;
  sizes: string;
  loading?: "eager" | "lazy";
  // "open" drops the bottom corners so the frame can run off a panel edge.
  open?: boolean;
  class?: string;
}

const {
  src,
  alt,
  url,
  sizes,
  loading = "lazy",
  open = false,
  class: className,
} = Astro.props;
---

<figure
  class={cn(
    "overflow-hidden bg-white ring-1 ring-black/5",
    open ? "rounded-t-card" : "rounded-card",
    className,
  )}
>
  <div class="flex items-center gap-3 border-b border-line px-4 py-3">
    <span class="flex gap-1.5" aria-hidden="true">
      <span class="size-2.5 rounded-full bg-line"></span>
      <span class="size-2.5 rounded-full bg-line"></span>
      <span class="size-2.5 rounded-full bg-line"></span>
    </span>
    <span
      class="mx-auto max-w-[60%] truncate rounded-full bg-paper px-4 py-1 text-xs text-subtle"
    >
      {url}
    </span>
    <span class="w-[42px]" aria-hidden="true"></span>
  </div>
  <Image
    src={src}
    alt={alt}
    widths={[640, 960, 1280, 1600]}
    sizes={sizes}
    loading={loading}
    fetchpriority={loading === "eager" ? "high" : "auto"}
    class="block h-auto w-full"
  />
</figure>
