---
import { Icon } from "astro-icon/components";
import Container from "@/components/Container";
import Logo from "@/components/Logo.astro";
import Button from "@/components/Button.astro";
import { contact, links, nav } from "@/data/site";
---

<header class="sticky top-0 z-40 bg-paper/90 backdrop-blur-md">
  <Container className="flex h-18 items-center justify-between gap-6">
    <a href="/" class="shrink-0" aria-label="OneUp Digital Studio, home">
      <Logo class="h-7 w-auto sm:h-8" />
    </a>

    <nav aria-label="Main" class="hidden lg:block">
      <ul class="flex items-center gap-8 text-[0.9375rem]">
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                class="text-ink/80 transition-colors hover:text-ink"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-2 sm:gap-5">
      <a
        href={contact.smsHref}
        class="hidden items-center gap-2 text-[0.9375rem] text-ink/80 hover:text-ink xl:inline-flex"
      >
        <Icon name="lucide:message-square" class="size-4" aria-hidden="true" />
        Text us
      </a>
      <a
        href={contact.phoneHref}
        class="hidden items-center gap-2 text-[0.9375rem] font-medium md:inline-flex"
      >
        <Icon name="lucide:phone" class="size-4" aria-hidden="true" />
        {contact.phone}
      </a>
      <a
        href={contact.phoneHref}
        class="inline-flex size-10 items-center justify-center rounded-full border border-line bg-white md:hidden"
        aria-label={`Call ${contact.phone}`}
      >
        <Icon name="lucide:phone" class="size-4" aria-hidden="true" />
      </a>
      <Button href={links.bookCall} size="md" class="hidden sm:inline-flex">
        Book a call
      </Button>
      <button
        type="button"
        class="group inline-flex size-10 items-center justify-center rounded-full border border-line bg-white lg:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Open menu"
        data-menu-toggle
      >
        <Icon
          name="lucide:menu"
          class="size-4.5 group-aria-expanded:hidden"
          aria-hidden="true"
        />
        <Icon
          name="lucide:x"
          class="hidden size-4.5 group-aria-expanded:block"
          aria-hidden="true"
        />
      </button>
    </div>
  </Container>

  <div id="mobile-menu" class="border-t border-line bg-paper lg:hidden" hidden>
    <Container className="py-6">
      <nav aria-label="Mobile">
        <ul class="divide-y divide-line">
          {
            nav.map((item) => (
              <li>
                <a href={item.href} class="block py-3.5 text-lg">
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <div class="mt-6 grid gap-3">
        <Button href={links.bookCall}>Book a call</Button>
        <div class="grid grid-cols-2 gap-3">
          <Button href={contact.phoneHref} variant="outline">
            <Icon name="lucide:phone" class="size-4" aria-hidden="true" />
            Call
          </Button>
          <Button href={contact.smsHref} variant="outline">
            <Icon
              name="lucide:message-square"
              class="size-4"
              aria-hidden="true"
            />
            Text
          </Button>
        </div>
      </div>
    </Container>
  </div>
</header>

<script>
  const toggle =
    document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
  const menu = document.getElementById("mobile-menu");

  toggle?.addEventListener("click", () => {
    const open = toggle.getAttribute("aria-expanded") === "true";
    toggle.setAttribute("aria-expanded", String(!open));
    toggle.setAttribute("aria-label", open ? "Open menu" : "Close menu");
    if (menu) menu.hidden = open;
  });
</script>
